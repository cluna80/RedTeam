  "invariant_oracles": {},
  "security_findings": [
    {
      "agent": "agent9_qpc_consensus",
      "title": "QPC-GAP-001: owner_identity_id not settable via tx API \u2014 per-human cap bypassable",
      "severity": "high",
      "invariant_id": null,
      "steps": [
        "1. Attacker creates N addresses (any number).",
        "2. Each address calls BondValidator{amount} + RegisterValidatorKey.",
        "3. Each resulting ValidatorRecord has owner_identity_id=None.",
        "4. build_validator_set() treats each None-owner as its own human.",
        "5. Each validator gets an independent power slot up to power_cap=1.",
        "6. N validators \u2192 N units of voting power, one human \u2192 power_cap violation."
      ],
      "expected": "BondValidator should accept an owner_identity_id parameter that binds the new validator to a specific verified human, so all validators sharing that human share a single power budget.",
      "actual": "BondValidator{amount: u128} carries no owner_identity_id field. chain-forge-execution/src/lib.rs hardcodes owner_identity_id=None at registration. The cap enforcement in build_validator_set() is correct in Rust but is never triggered for post-genesis validators because the binding is never set.",
      "evidence": {
        "rust_gap_location": "chain-forge-execution/src/lib.rs:2112-2123 (BondValidator handler)",
        "cap_enforcement_location": "chain-forge-validators/src/lib.rs:992-1035 (build_validator_set)",
        "git_sha": "e7fbd5a",
        "affected_tests": [
          "QPC-A01",
          "QPC-A03",
          "QPC-A10"
        ]
      },
      "timestamp": "2026-10-23T10:59:52.366772+00:00",
      "finding_id": "c23f6192-cc83-4bb4-905c-ebd81ff64bc7",
      "regression_path": null
    },
    {
      "agent": "agent9_qpc_consensus",
      "title": "QPC-GAP-002: pop_verified attestation requires coordinator centralization",
      "severity": "medium",
      "invariant_id": null,
      "steps": [
        "1. New validator bonds stake and registers consensus key.",
        "2. validator.pop_verified remains false until coordinator attests.",
        "3. gate_voting_power() zeroes power for unverified validators.",
        "4. Only qcb1alice (single coordinator) can grant pop_verified=true on devnet.",
        "5. Attestation centralization is noted as temporary in whitepaper \u00a74."
      ],
      "expected": "Decentralized personhood verification with no single coordinator gate. At mainnet, multiple approved issuers should be able to attest personhood independently (ZK-VRC / VRC-registry path in chain-forge-personhood).",
      "actual": "On the 3-node devnet, attestation_coordinator=qcb1alice (genesis-3node.json). Only this single address can issue Attest txs that grant pop_verified=true. Multi-issuer path (chain-forge-personhood ZK circuits) exists in codebase but is not wired into the live validator admission flow.",
      "evidence": {
        "coordinator_config": "tests/devnet/genesis-3node.json:attestation_coordinator=qcb1alice",
        "gate_location": "chain-forge-consensus/src/lib.rs:614 (gate_voting_power)",
        "zk_vrc_location": "chain-forge-personhood/src/lib.rs (Groth16VrcVerifier)",
        "git_sha": "e7fbd5a",
        "affected_tests": [
          "QPC-A02",
          "QPC-A05"
        ],
        "whitepaper_reference": "Section 4 \u2014 Identity Pilot centralization note"
      },
